# Copy to .env and edit. Every value here is optional.

# Host port the container is published on (container side is always 8080).
MIDWAY_PORT=8080

# Image to run. Override to pin a digest or a commit SHA tag:
#   MIDWAY_IMAGE=ghcr.io/<owner>/portfolio-project-1/demo1-ride:sha-1a2b3c4
MIDWAY_IMAGE=ghcr.io/ec061/portfolio-project-1/demo1-ride:latest

# Sub-path the app is served from. Only needed when the reverse proxy
# mounts it somewhere other than the root, e.g. BASE_PATH=/midway/
BASE_PATH=/
